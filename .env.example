# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---------------------------------------------------------------- model access
# One provider key. Every agent goes through the LiteLLM proxy, so this is the
# only place a real credential appears.
LLM_API_KEY=

# Protects the proxy itself. Any random string; the orchestrator sends it as its
# OpenAI API key.
LITELLM_MASTER_KEY=sk-loop-local-dev

# ----------------------------------------------------------------- model tiers
# Provider-qualified model ids in LiteLLM's format. Must match the models priced in
# cost-model.properties, or the gate-1 estimate quietly stops describing what runs.
#
# Prices per million tokens, cached 2026-06-24 — check before quoting:
#   opus-5    $5 in / $25 out      sonnet-5  $2 in / $10 out
#   haiku-4-5 $1 in / $5  out
STRONG_MODEL=anthropic/claude-opus-5
MID_MODEL=anthropic/claude-sonnet-5
CHEAP_MODEL=anthropic/claude-haiku-4-5

# The reviewer is meant to be a different model family from whichever agent wrote the
# code, because a model tends to bless work from its own family. Pointing this at another
# Claude model keeps the tier working but weakens that mitigation — see PHASES.md phase 9.
REVIEW_MODEL=anthropic/claude-sonnet-5

# ------------------------------------------------------------------- endpoints
TEMPORAL_TARGET=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
QDRANT_URL=http://localhost:6333
LITELLM_BASE_URL=http://localhost:4000

# ---------------------------------------------------------------------- limits
# How long a workflow will wait for a person before it gives up and escalates.
# Days, not minutes. If this fires often, the question queue is not being watched.
HUMAN_ANSWER_TIMEOUT_DAYS=3

# Rework multiplier used by the gate-1 estimate. Recalibrate monthly from the
# last 20 stories — it drifts whenever the pipeline improves or degrades.
REWORK_MULTIPLIER=1.45
